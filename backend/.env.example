# ---------------------------------------------------------------
# Ten.Di ERP - API configuration
# Copy to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000
APP_NAME=Ten.Di ERP

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<>:<db_password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB_NAME=<database_name>

# Optional startup/shutdown tuning. The API never opens its port until MongoDB connects;
# after the attempts are exhausted it exits with code 1.
# MONGODB_CONNECT_MAX_ATTEMPTS=5        # default: 5 in production, 10 otherwise
# MONGODB_CONNECT_RETRY_BASE_MS=2000    # exponential backoff base, capped at 30s
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# SHUTDOWN_TIMEOUT_MS=10000             # max time to drain requests before forced exit

# Allowed browser origins (CORS), comma separated, written exactly as the browser
# sends them: scheme://host[:port], no path or trailing slash. https:// is required
# in production. The first is used in emailed links.
CLIENT_URL=http://localhost:5173
# Reverse proxies trusted for the client IP used by rate limits and audit logs:
# "false" (clients connect directly), a hop count (e.g. 1 behind one load balancer),
# or IPs/CIDRs/presets such as loopback,10.0.0.0/8. Required in production;
# unset = false elsewhere. "true" is rejected.
# TRUST_PROXY=1

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=lumos_session
# lax for same-site deployments; use none (requires HTTPS) if client and API are on different sites
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

PASSWORD_RESET_TTL_MINUTES=30
# Development only: print password reset links (live credentials) to the API console
# LOG_PASSWORD_RESET_LINKS=false
BCRYPT_SALT_ROUNDS=12

# File storage: cloudinary (s3 reserved for a future provider)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lumos-erp
MAX_UPLOAD_SIZE_MB=10
# Optional upload limits (defaults shown). Worst-case buffered memory is
# MAX_CONCURRENT_UPLOADS x MAX_UPLOAD_TOTAL_MB.
# MAX_UPLOAD_FILES=10
# MAX_UPLOAD_TOTAL_MB=25
# MAX_CONCURRENT_UPLOADS=4
# Uploads one user may run at once (must not exceed MAX_CONCURRENT_UPLOADS)
# MAX_CONCURRENT_UPLOADS_PER_USER=2
# Seconds allowed for the whole request body to arrive before answering 408
# UPLOAD_BODY_TIMEOUT_SECONDS=120
# Lifetime of signed download links for private files
# FILE_URL_TTL_SECONDS=300

# First Super Admin, created by `npm run seed` if the email does not exist yet
SEED_ADMIN_EMAIL=admin@lumos.example
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
