# ---------------------------------------------------------------
# Ten.Di ERP - client configuration
# Copy to frontend/.env. Only VITE_* variables reach the browser;
# never put secrets here.
# ---------------------------------------------------------------

# API base path or absolute URL. Keep "/api/v1" in development (proxied by Vite).
# In production either serve the API on the same domain or set the full URL,
# e.g. https://api.lumos.example/api/v1
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=Ten.Di ERP

# Development only: where Vite proxies /api requests
VITE_DEV_API_PROXY_TARGET=http://localhost:5000
VITE_DEV_PORT=5173
